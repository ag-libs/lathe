<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>multi-module</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>core</module>
    <module>app</module>
    <module>health</module>
    <module>jpms</module>
    <module>shapes</module>
    <module>verify</module>
  </modules>

  <properties>
    <!-- Target Lathe's own baseline (21) so this IT compiles on every CI JDK in
         the matrix; the fixture uses no release-25 features and asserts nothing
         about the release, and modern-JDK coverage lives in the external test
         projects (dropwizard/helidon on Java 25). -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <!-- Pinned as a real project on Maven 3.6 must: its default bindings (compiler 3.1, Surefire
         2.12.4) cannot build a Java 17 project. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>@compiler.version@</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>@surefire.version@</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Config-only (no version, no executions): Spotless never runs in this IT, but lathe:sync
           reads this formatter config to generate .lathe/style.json with the google engine. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!-- The first invoker build only (invoker.profiles.1): seeds captures this build no longer has,
       before the root's lathe:sync prunes them, a module not in the reactor and a test tree for
       health, which has no tests; MultiModuleTest checks they are gone. The second build is partial,
       so it would keep them for the client tests that run against this fixture later. -->
  <profiles>
    <profile>
      <id>seed-stale-captures</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>seed-stale-captures</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>initialize</phase>
                <configuration>
                  <outputDirectory>${project.basedir}/.lathe</outputDirectory>
                  <resources>
                    <resource>
                      <directory>stale-captures</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
