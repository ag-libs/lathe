<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ag-libs</groupId>
    <artifactId>lathe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lathe-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>lathe-maven-plugin</name>
  <description>Lathe Maven plugin providing the init and sync goals.</description>

  <properties>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <!-- The invoker projects build in parallel; -Dinvoker.parallelThreads=1 runs them one by one. -->
    <invoker.parallelThreads>2</invoker.parallelThreads>
    <!-- The fixtures' Lathe cache, under a path with a space, so the launchers and their argfiles
         are tested with one. -->
    <lathe.it.cache>${project.build.directory}/it home/.cache/lathe</lathe.it.cache>
    <!-- The personal-activation fixture's -Dmaven.ext.class.path, as :LatheInit passes it: the
         extension and its runtime dependencies, from the fixtures' local repository. Built here, as
         the invoker interpolates project properties but not path.separator. -->
    <lathe.it.repo>${project.build.directory}/local-repo</lathe.it.repo>
    <lathe.it.extClassPath>${lathe.it.repo}/io/github/ag-libs/lathe-maven-extension/${project.version}/lathe-maven-extension-${project.version}.jar${path.separator}${lathe.it.repo}/io/github/ag-libs/lathe-core/${project.version}/lathe-core-${project.version}.jar${path.separator}${lathe.it.repo}/com/google/code/gson/gson/${gson.version}/gson-${gson.version}.jar${path.separator}${lathe.it.repo}/io/github/ag-libs/validcheck/validcheck/${validcheck.version}/validcheck-${validcheck.version}.jar</lathe.it.extClassPath>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-install</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-install-maven</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs.validcheck</groupId>
      <artifactId>validcheck</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-compiler</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-server</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Build order only: the invoker installs these as extraArtifacts, so a parallel build must
         package them first, or it installs a module's target/classes directory. -->
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-junit</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-test-runner</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-maven-extension</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-it-support</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
      <!-- Build order only, like the jars above; its lsp4j and AssertJ stay off this classpath. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-mcp-server</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
      <!-- Its MCP SDK, Jackson 3 and SLF4J binding have no place on this plugin's classpath. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin.version}</version>
      </plugin>
      <plugin>
        <!-- The invoker keeps Lathe's own artifacts and the server launchers it unpacks between runs,
             so a rebuilt SNAPSHOT would be tested as the previous build. Drop them before it installs
             fresh ones (same phase, declared first); the JDK, dependency and type-index caches stay. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
        <executions>
          <execution>
            <id>drop-previous-lathe-build</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.directory}/local-repo/io/github/ag-libs</directory>
                </fileset>
                <fileset>
                  <directory>${lathe.it.cache}/servers</directory>
                </fileset>
                <fileset>
                  <directory>${lathe.it.cache}/latest</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>${maven-invoker-plugin.version}</version>
        <configuration>
          <skipInvocation>${skipTests}</skipInvocation>
          <projectsDirectory>src/it</projectsDirectory>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
          <!-- A fixture build that hangs (a server wait gone wrong) fails as that fixture, not the job. -->
          <timeoutInSeconds>600</timeoutInSeconds>
          <extraArtifacts>
            <extraArtifact>io.github.ag-libs:lathe-junit:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-test-runner:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-maven-extension:${project.version}:jar</extraArtifact>
            <!-- The fixtures resolve these at build or sync time; installed here, they come from this build,
                 never from a stale ~/.m2. -->
            <extraArtifact>io.github.ag-libs:lathe-compiler:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-server:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-mcp-server:${project.version}:jar</extraArtifact>
            <!-- The fixtures' checks start the servers through these shared helpers. -->
            <extraArtifact>io.github.ag-libs:lathe-it-support:${project.version}:jar</extraArtifact>
          </extraArtifacts>
          <settingsFile>src/it/settings.xml</settingsFile>
          <!-- The projects build in parallel and share the local repository: lock it across processes. -->
          <!-- Passed as its own -D argument: MAVEN_OPTS would split the path at its space. -->
          <properties>
            <lathe.cache>${lathe.it.cache}</lathe.cache>
            <!-- The fixtures build with Lathe enabled even on CI, where the CI variable would keep it
                 out; their test forks get it too, as Surefire passes user properties on. -->
            <lathe.disabled>false</lathe.disabled>
          </properties>
          <!-- Lock files are kept: on Windows, one build cannot open a lock file another is deleting,
               so two fixtures resolving one artifact failed after the default 5 tries 50ms apart. The
               longer retry rides out a scanner holding the file. -->
          <mavenOpts>-DlatheLocalRepo=${settings.localRepository} -Daether.syncContext.named.factory=file-lock -Daether.syncContext.named.nameMapper=file-gav -Daether.named.file-lock.deleteLockFiles=false -Daether.named.file-lock.attempts=50 -Daether.named.file-lock.sleepMillis=100</mavenOpts>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
