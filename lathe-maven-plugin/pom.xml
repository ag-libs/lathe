<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ag-libs</groupId>
    <artifactId>lathe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lathe-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>lathe-maven-plugin</name>
  <description>Lathe Maven plugin providing the init and sync goals.</description>

  <properties>
    <maven-invoker-plugin.version>3.10.1</maven-invoker-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <!-- The invoker projects build in parallel; -Dinvoker.parallelThreads=1 runs them one by one. -->
    <invoker.parallelThreads>2</invoker.parallelThreads>
    <!-- The spotless-lib and spotless-lib-extra that spotless-maven-plugin ${spotless.version} ships. -->
    <spotless-lib.version>4.10.4</spotless-lib.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-install</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs.validcheck</groupId>
      <artifactId>validcheck</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-compiler</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-server</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Tests read Spotless's step defaults from real Spotless libraries in target/, loaded in an
             isolated classloader the way sync loads a project's; it is never on the test class path. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-test-spotless-lib</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>process-test-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/test-spotless</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>com.diffplug.spotless</groupId>
                  <artifactId>spotless-lib</artifactId>
                  <version>${spotless-lib.version}</version>
                  <destFileName>spotless-lib.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.diffplug.spotless</groupId>
                  <artifactId>spotless-lib-extra</artifactId>
                  <version>${spotless-lib.version}</version>
                  <destFileName>spotless-lib-extra.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin.version}</version>
      </plugin>
      <plugin>
        <!-- The invoker keeps Lathe's own artifacts and the server launchers it unpacks between runs,
             so a rebuilt SNAPSHOT would be tested as the previous build. Drop them before it installs
             fresh ones (same phase, declared first); the JDK, dependency and type-index caches stay. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
        <executions>
          <execution>
            <id>drop-previous-lathe-build</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.directory}/local-repo/io/github/ag-libs</directory>
                </fileset>
                <fileset>
                  <directory>${project.build.directory}/it-home/.cache/lathe/servers</directory>
                </fileset>
                <fileset>
                  <directory>${project.build.directory}/it-home/.cache/lathe/latest</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>${maven-invoker-plugin.version}</version>
        <configuration>
          <skipInvocation>${skipTests}</skipInvocation>
          <projectsDirectory>src/it</projectsDirectory>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
          <extraArtifacts>
            <extraArtifact>io.github.ag-libs:lathe-junit:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-test-runner:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-maven-extension:${project.version}:jar</extraArtifact>
            <!-- The fixtures resolve these at build or sync time; installed here, they come from this build,
                 never from a stale ~/.m2. -->
            <extraArtifact>io.github.ag-libs:lathe-compiler:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-server:${project.version}:jar</extraArtifact>
            <extraArtifact>io.github.ag-libs:lathe-mcp-server:${project.version}:jar</extraArtifact>
          </extraArtifacts>
          <settingsFile>src/it/settings.xml</settingsFile>
          <!-- The projects build in parallel and share the local repository: lock it across processes. -->
          <mavenOpts>-Dlathe.cache=${project.build.directory}/it-home/.cache/lathe -DlatheLocalRepo=${settings.localRepository} -Daether.syncContext.named.factory=file-lock -Daether.syncContext.named.nameMapper=file-gav</mavenOpts>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
