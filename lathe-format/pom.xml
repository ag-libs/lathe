<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ag-libs</groupId>
    <artifactId>lathe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lathe-format</artifactId>

  <name>lathe-format</name>
  <description>JDK-resilient Java source formatter: a fork of google-java-format re-hosted on the
    public Compiler Tree API, requiring no --add-exports. Bundled by lathe-server and publishable
    standalone.</description>

  <properties>
    <!-- Exporting jdk.compiler internals is incompatible with the release flag; use source/target. -->
    <maven.compiler.release></maven.compiler.release>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <guava.version>32.1.3-jre</guava.version>
    <jspecify.version>1.0.0</jspecify.version>
    <errorprone.version>2.47.0</errorprone.version>
    <auto-value.version>1.9</auto-value.version>
    <junit4.version>4.13.2</junit4.version>
    <truth.version>1.4.0</truth.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
      <version>${errorprone.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.auto.value</groupId>
      <artifactId>auto-value-annotations</artifactId>
      <version>${auto-value.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test-scope reference for the harness; the forked formatter is validated against it, not shipped. -->
    <dependency>
      <groupId>com.google.googlejavaformat</groupId>
      <artifactId>google-java-format</artifactId>
      <version>${google-java-format.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>

    <!-- The vendored upstream GJF unit suites stay verbatim (JUnit 4 + Truth) so upstream merges
         apply cleanly; the vintage engine runs them on the JUnit Platform. -->
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit4.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId>
      <artifactId>truth</artifactId>
      <version>${truth.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava-testlib</artifactId>
      <version>${guava.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.auto.value</groupId>
              <artifactId>auto-value</artifactId>
              <version>${auto-value.version}</version>
            </path>
          </annotationProcessorPaths>
          <!-- Vendored GJF reaches into javac internals; the fork module needs them exported to it
               at compile time. -Werror is dropped: lint on third-party code is not actionable. -->
          <compilerArgs combine.self="override">
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.api=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.code=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.comp=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.file=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.main=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.model=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.parser=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.processing=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.tree=io.github.aglibs.lathe.format</arg>
            <arg>--add-exports</arg>
            <arg>jdk.compiler/com.sun.tools.javac.util=io.github.aglibs.lathe.format</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Both the forked module and the GJF reference (test-classpath, unnamed) reach into
               javac internals. Temporary: the fork's half goes away as seams are de-internalized. -->
          <argLine>@{argLine}
            --add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED
            --add-exports jdk.compiler/com.sun.tools.javac.api=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.code=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.comp=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.file=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.main=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.model=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.parser=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.processing=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.tree=io.github.aglibs.lathe.format
            --add-exports jdk.compiler/com.sun.tools.javac.util=io.github.aglibs.lathe.format
            --add-opens jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED
            --add-opens jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED
            --add-opens jdk.compiler/com.sun.tools.javac.code=io.github.aglibs.lathe.format
            --add-opens jdk.compiler/com.sun.tools.javac.comp=io.github.aglibs.lathe.format</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
