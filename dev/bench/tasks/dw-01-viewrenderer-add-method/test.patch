+package io.dropwizard.views.freemarker;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import freemarker.template.Configuration;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hidden oracle for benchmark task dw-01 (FAIL_TO_PASS). Pins the Freemarker renderer's implementation
+ * of the new {@code ViewRenderer.getSupportedTemplateSuffixes()} SPI method to its exact suffix set,
+ * so a missing or placeholder implementation fails.
+ */
+class FreemarkerSupportedSuffixesTest {
+
+    @Test
+    void getSupportedTemplateSuffixes_freemarkerRenderer_returnsFreemarkerSuffixes() {
+        assertThat(
+                new FreemarkerViewRenderer(Configuration.DEFAULT_INCOMPATIBLE_IMPROVEMENTS)
+                    .getSupportedTemplateSuffixes())
+            .containsExactlyInAnyOrder(".ftl", ".ftlh", ".ftlx");
+    }
+}
