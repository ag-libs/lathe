+package io.dropwizard.views.mustache;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hidden oracle for benchmark task dw-01 (FAIL_TO_PASS). Pins the Mustache renderer's implementation
+ * of the new {@code ViewRenderer.getSupportedTemplateSuffixes()} SPI method to its exact suffix set,
+ * so a missing or placeholder implementation fails.
+ */
+class MustacheSupportedSuffixesTest {
+
+    @Test
+    void getSupportedTemplateSuffixes_mustacheRenderer_returnsMustacheSuffix() {
+        assertThat(new MustacheViewRenderer().getSupportedTemplateSuffixes())
+            .containsExactlyInAnyOrder(".mustache");
+    }
+}
