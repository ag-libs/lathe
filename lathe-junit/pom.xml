<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ag-libs</groupId>
    <artifactId>lathe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lathe-junit</artifactId>

  <name>lathe-junit</name>
  <description>Lathe test-capture listener that records the Surefire fork launch.</description>

  <properties>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ag-libs</groupId>
      <artifactId>lathe-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- JUnit loads the listener and the filter in every test JVM, and the Gradle plugin loads
             the agent there, including one older than Lathe's code (Java 17), which then must not
             fail to load them: they are compiled for Java 8 and leave the capture alone below 17. The rest stays Java 17. Plain javac, not
             Lathe's capturing compiler, so the editor keeps analysing this module as Java 17. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <excludes>
                <exclude>**/CaptureLauncherSessionListener.java</exclude>
                <exclude>**/CaptureOnlyPostDiscoveryFilter.java</exclude>
                <exclude>**/LatheAgent.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>compile-for-any-test-jvm</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <compilerId>javac</compilerId>
              <release>8</release>
              <includes>
                <include>**/CaptureLauncherSessionListener.java</include>
                <include>**/CaptureOnlyPostDiscoveryFilter.java</include>
                <include>**/LatheAgent.java</include>
              </includes>
              <compilerArgs combine.children="append">
                <!-- -Werror would fail on two harmless warnings: javac's that release 8 is
                     deprecated, and newer libraries' @Deprecated(since, forRemoval), which Java 8's
                     API does not have. -->
                <arg>-Xlint:-options</arg>
                <arg>-Xlint:-classfile</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <lathe.disabled>true</lathe.disabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <artifactSet>
                <excludes>
                  <exclude>com.google.errorprone:error_prone_annotations</exclude>
                </excludes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.google.gson</pattern>
                  <shadedPattern>io.github.aglibs.lathe.junit.shaded.gson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.github.aglibs.lathe.core</pattern>
                  <shadedPattern>io.github.aglibs.lathe.junit.shaded.core</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.github.aglibs.validcheck</pattern>
                  <shadedPattern>io.github.aglibs.lathe.junit.shaded.validcheck</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- The Gradle plugin starts the test JVM with this jar as an agent; see LatheAgent. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>io.github.aglibs.lathe.junit.LatheAgent</Premain-Class>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.google.code.gson:gson</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/proguard/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.github.ag-libs:lathe-core</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.github.ag-libs.validcheck:validcheck</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
