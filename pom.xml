<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ag-libs</groupId>
  <artifactId>lathe-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>lathe-parent</name>
  <description>Lathe — a Java language server for Maven projects.</description>
  <url>https://github.com/ag-libs/lathe</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>agavrilov76</id>
      <name>Alexey Gavrilov</name>
      <url>https://github.com/agavrilov76</url>
    </developer>
  </developers>

  <modules>
    <module>lathe-core</module>
    <module>lathe-format</module>
    <module>lathe-junit</module>
    <module>lathe-test-runner</module>
    <module>lathe-compiler</module>
    <module>lathe-server</module>
    <module>lathe-mcp-server</module>
    <module>lathe-maven-extension</module>
    <module>lathe-install</module>
    <module>lathe-maven-plugin</module>
    <module>lathe-openjdk-maven-plugin</module>
    <module>lathe-neovim</module>
    <module>lathe-vscode</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/ag-libs/lathe.git</connection>
    <developerConnection>scm:git:https://github.com/ag-libs/lathe.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/ag-libs/lathe/tree/main</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>central</id>
      <url>https://central.sonatype.com/</url>
    </repository>
  </distributionManagement>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- dependency versions -->
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.24.0</mockito.version>
    <spotless.version>3.10.3</spotless.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <compiler.version>3.16.0</compiler.version>
    <git-commit-id.version>10.0.1</git-commit-id.version>
    <!-- 3.5.5 regresses the forked-VM exit handshake (ThreadedStreamConsumer.Pumper hang,
         "VM terminated without properly saying goodbye", Tests run: 0) when the build runs
         under a directly-launched mvn process (not the mvnd daemon); see
         docs/planned/lathe-run-test-debug.md section 14 -->
    <surefire.version>3.5.4</surefire.version>
    <jar.version>3.5.1</jar.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- default empty so @{argLine} resolves when JaCoCo agent is not active -->
    <argLine></argLine>
    <lsp4j.version>1.0.0</lsp4j.version>
    <plexus-compiler.version>2.17.1</plexus-compiler.version>
    <plexus-java.version>1.6.0</plexus-java.version>
    <gson.version>2.14.0</gson.version>
    <validcheck.version>0.11.0</validcheck.version>
    <java-debug.version>0.53.1</java-debug.version>
    <mcp-sdk.version>2.0.1</mcp-sdk.version>

    <!-- Maven plugin/extension API, shared by lathe-install and the three Maven front-ends -->
    <maven-api.version>3.9.15</maven-api.version>
    <maven-plugin.version>3.16.0</maven-plugin.version>

    <!-- release plugin versions (activated by the release profile) -->
    <maven-source.version>3.4.0</maven-source.version>
    <maven-javadoc.version>3.12.0</maven-javadoc.version>
    <maven-gpg.version>3.2.8</maven-gpg.version>
    <central-publishing.version>0.11.0</central-publishing.version>

    <!--
      Extra args appended to the VS Code `npm run package` (vsce) invocation. Empty
      by default so local/dev builds package the SNAPSHOT version from package.json;
      the release profile overrides this to stamp the release version into the .vsix.
    -->
    <vsce.package.args></vsce.package.args>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-format</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-junit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-test-runner</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-compiler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.lsp4j</groupId>
        <artifactId>org.eclipse.lsp4j</artifactId>
        <version>${lsp4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.lsp4j</groupId>
        <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
        <version>${lsp4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-compiler-api</artifactId>
        <version>${plexus-compiler.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-compiler-javac</artifactId>
        <version>${plexus-compiler.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-java</artifactId>
        <version>${plexus-java.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-launcher</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microsoft.java</groupId>
        <artifactId>com.microsoft.java.debug.core</artifactId>
        <version>${java-debug.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.ag-libs.validcheck</groupId>
        <artifactId>validcheck</artifactId>
        <version>${validcheck.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
            </java>
            <formats>
              <format>
                <includes>
                  <include>**/*.md</include>
                  <include>**/*.sh</include>
                </includes>
                <trimTrailingWhitespace></trimTrailingWhitespace>
                <endWithNewline></endWithNewline>
              </format>
            </formats>
            <pom>
              <sortPom></sortPom>
            </pom>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.version}</version>
          <configuration>
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
              <manifestEntries>
                <Lathe-Build-Time>${git.build.time}</Lathe-Build-Time>
                <Lathe-Git-Commit>${git.commit.id.abbrev}</Lathe-Git-Commit>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc.version}</version>
          <configuration>
            <doclint>none</doclint>
            <quiet>true</quiet>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${maven-gpg.version}</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central-publishing.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>${git-commit-id.version}</version>
        <configuration>
          <generateGitPropertiesFile>false</generateGitPropertiesFile>
        </configuration>
        <executions>
          <execution>
            <id>git-revision</id>
            <goals>
              <goal>revision</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
    <extensions>
      <extension>
        <groupId>io.github.ag-libs</groupId>
        <artifactId>lathe-maven-extension</artifactId>
        <version>0.1.18</version>
      </extension>
    </extensions>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <!--
          Stamp the release version into the VS Code .vsix. Passing the version to
          vsce with the no-update-package-json flag names and versions the artifact
          without writing package.json (which stays on 0.1.0-SNAPSHOT like the POMs)
          and without running npm version or git, so it is safe in the dirty CI tree
          that versions:set leaves behind.
        -->
        <vsce.package.args>-- ${project.version} --no-update-package-json</vsce.package.args>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals>
                  <goal>sign</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <!--
                The Neovim and VS Code clients are editor plugins, not library
                artifacts: they are distributed through their own channels (the
                lathe.nvim mirror and the VS Code Marketplace / Open VSX), not
                Maven Central. They are pom-only modules whose presence in the
                aggregated bundle breaks the Central deployment. Exclude them by
                artifactId so vscode still drives the final publish of the rest.
              -->
              <excludeArtifacts>
                <excludeArtifact>lathe-neovim</excludeArtifact>
                <excludeArtifact>lathe-vscode</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
